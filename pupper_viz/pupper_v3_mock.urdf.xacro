<?xml version="1.0"?>
<!-- Same as pupper_v3.urdf.xacro but with mock hardware instead of the real
     control board, so ros2_control runs in the viz-only Docker sandbox. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pupper_v3">

  <xacro:include filename="$(find pupper_v3_description)/description/urdf/pupper_v3.edited.fixed.urdf" />

  <xacro:include filename="$(find pupper_v3_description)/description/components.xacro" />

  <ros2_control name="mock_control_board" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <xacro:define_components />
  </ros2_control>

  <gazebo reference="single_rrbot_hokuyo_link">
    <sensor name="gpu_lidar" type="gpu_lidar">
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>single_rrbot_hokuyo_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>true</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
